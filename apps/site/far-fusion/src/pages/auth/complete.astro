---
export const prerender = false;
import BaseLayout from "../../layouts/BaseLayout.astro";

const cookieValue = Astro.cookies.get("google_auth_result")?.value;
const next = Astro.url.searchParams.get("next") || "/account";

let userJson = null;
if (cookieValue) {
  try {
    const parsed = JSON.parse(decodeURIComponent(cookieValue));
    userJson = JSON.stringify(parsed);
    Astro.cookies.delete("google_auth_result", { path: "/" });
  } catch {}
}
---

<BaseLayout title="Signing in… — Ulsaham Entertainments">
  <div class="min-h-screen bg-primary text-light flex items-center justify-center">
    <div class="text-center space-y-4">
      <div class="auth-spinner"></div>
      <p class="text-light/50 text-sm">Completing sign-in…</p>
    </div>
  </div>

  <script is:inline define:vars={{ userJson, next }}>
    if (!userJson) {
      window.location.replace("/login?error=no_auth_result");
    } else {
      try {
        var googleUser = JSON.parse(userJson);
        var KEY = "ulsaham_user";
        var ACCOUNTS_KEY = "ulsaham_accounts";
        var existing = JSON.parse(localStorage.getItem(KEY) || "null");
        var merged = (existing && existing.email === googleUser.email)
          ? Object.assign({}, existing, googleUser)
          : Object.assign({ tickets: [] }, googleUser);
        localStorage.setItem(KEY, JSON.stringify(merged));
        // Update known accounts so re-login after logout routes correctly
        try {
          var accts = JSON.parse(localStorage.getItem(ACCOUNTS_KEY) || "{}");
          accts[merged.email.toLowerCase()] = {
            name: merged.name,
            phone: merged.phone,
            hasGoogle: true,
            googleId: merged.googleId,
          };
          localStorage.setItem(ACCOUNTS_KEY, JSON.stringify(accts));
        } catch(e2) {}
        window.location.replace(next);
      } catch (e) {
        window.location.replace("/login?error=auth_failed");
      }
    }
  </script>
</BaseLayout>

<style>
  .auth-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(155, 202, 59, 0.2);
    border-top-color: #9bca3b;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin: 0 auto;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
