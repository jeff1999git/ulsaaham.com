---
// Static: the Google result arrives in a cookie that script can read, so this
// page needs no function. The script below does the work in the browser.
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Signing in… — Ulsaham Entertainments" noindex>
  <div class="min-h-screen bg-primary text-light flex items-center justify-center">
    <div class="text-center space-y-4">
      <div class="auth-spinner"></div>
      <p class="text-light/50 text-sm">Completing sign-in…</p>
    </div>
  </div>

  <script>
    // Reads and clears the result cookie, saves the user and leaves for a path
    // on this site (or /login with an error code). See lib/google-complete.js.
    import { completeGoogleSignIn } from "../../lib/google-complete.js";

    window.location.replace(completeGoogleSignIn(document, window.location));
  </script>
</BaseLayout>

<style>
  .auth-spinner {
    width: 36px;
    height: 36px;
    border: 3px solid rgba(155, 202, 59, 0.2);
    border-top-color: #9bca3b;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin: 0 auto;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
