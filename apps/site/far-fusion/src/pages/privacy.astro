---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy Policy — Ulsaham Entertainments" description="Privacy policy for Ulsaham Entertainments events and ticketing platform.">
  <div class="min-h-screen bg-primary text-light">

    <nav class="hero-video__menu">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <a href="/" class="hero-logo-link" aria-label="Ulsaham Home">
          <img src="/brand_logo.avif" alt="Ulsaham" class="topbar-logo" />
          <div class="hero-logo-link__brand">
            <span class="hero-logo-link__name">ULSAHAM</span>
            <span class="hero-logo-link__sub">Entertainments</span>
          </div>
        </a>
      </div>
      <div class="hero-video__menu-links">
        <a class="hero-video__menu-link" href="/events">Events</a>
        <a class="hero-video__menu-link" href="/#connect">Connect</a>
        <div class="profile-menu-wrap" id="profile-menu-wrap">
          <a id="hero-auth" class="topbar-avatar" href="/login" aria-label="Login" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
          <div class="mobile-nav-dropdown" id="mobile-nav-dropdown" role="menu">
            <a href="/events" class="mobile-nav-dropdown__link" role="menuitem">Events</a>
            <a href="/#connect" class="mobile-nav-dropdown__link" role="menuitem">Connect</a>
            <div class="mobile-nav-dropdown__divider"></div>
            <a id="mobile-account-link" href="/login" class="mobile-nav-dropdown__link mobile-nav-dropdown__link--account" role="menuitem">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <span id="mobile-account-label">Account</span>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <script>
      const u = JSON.parse(localStorage.getItem("ulsaham_user") || "null");
      const el = document.getElementById("hero-auth");
      const mobileLink = document.getElementById("mobile-account-link");
      const mobileLabel = document.getElementById("mobile-account-label");
      if (el && u) { el.href = "/account"; el.setAttribute("aria-label", "My Account"); el.innerHTML = `<span class="topbar-avatar__letter">${(u.name||"?")[0].toUpperCase()}</span>`; }
      if (mobileLink && u) { mobileLink.href = "/account"; }
      if (mobileLabel && u) { mobileLabel.textContent = `Hi, ${(u.name||"?").split(" ")[0]}`; }
      const wrap = document.getElementById("profile-menu-wrap");
      const dropdown = document.getElementById("mobile-nav-dropdown");
      if (el && wrap && dropdown) {
        el.addEventListener("click", function(e) {
          if (window.innerWidth <= 640) { e.preventDefault(); const open = dropdown.classList.toggle("is-open"); el.setAttribute("aria-expanded", open ? "true" : "false"); }
        });
        dropdown.querySelectorAll(".mobile-nav-dropdown__link").forEach(function(link) {
          link.addEventListener("click", function() { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); });
        });
        document.addEventListener("click", function(e) {
          if (!wrap.contains(e.target)) { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); }
        });
      }
    </script>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-16 sm:pt-24 pb-16 md:pb-24">
      <h1 class="section-title text-3xl mb-2">Privacy Policy</h1>
      <p class="section-subtitle mb-12">Last updated: June 2025</p>

      <div class="space-y-10 text-light/80 leading-relaxed">

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">1. Information We Collect</h2>
          <p>When you book an event or create an account on our platform, we collect personal information such as your name, email address, and phone number. We also collect ticket purchase details and payment confirmation records.</p>
          <p>We do not store full payment card details. Payments are processed securely through our payment partners.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">2. How We Use Your Information</h2>
          <p>We use your information to:</p>
          <ul class="list-disc list-inside space-y-2 ml-2">
            <li>Process and confirm your event registrations</li>
            <li>Send you ticket confirmations and event updates</li>
            <li>Manage your account and provide customer support</li>
            <li>Improve our platform and event experiences</li>
          </ul>
          <p>We do not sell or rent your personal information to third parties.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">3. Data Storage</h2>
          <p>Your data is stored securely on our servers. We take reasonable measures to protect your information from unauthorized access, disclosure, or loss. Account data is retained for as long as your account is active or as required by law.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">4. Cookies</h2>
          <p>Our website uses local storage to keep you logged in across sessions. We do not use tracking cookies for advertising purposes.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">5. Third-Party Services</h2>
          <p>We use trusted third-party services for payment processing and media hosting. These services have their own privacy policies and we encourage you to review them.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">6. Your Rights</h2>
          <p>You have the right to access, correct, or request deletion of your personal data. To exercise these rights, contact us at <a href="https://mail.google.com/mail/?view=cm&to=ulsaham1@gmail.com" target="_blank" rel="noreferrer" class="text-accent hover:underline">ulsaham1@gmail.com</a>.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">7. Changes to This Policy</h2>
          <p>We may update this policy from time to time. Any changes will be posted on this page with an updated date. Continued use of our platform after changes constitutes acceptance of the revised policy.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">8. Contact</h2>
          <p>If you have any questions about this Privacy Policy, reach us at:</p>
          <p><a href="https://mail.google.com/mail/?view=cm&to=ulsaham1@gmail.com" target="_blank" rel="noreferrer" class="text-accent hover:underline">ulsaham1@gmail.com</a></p>
        </section>

      </div>
    </div>

    <footer class="bg-primary py-8 border-t border-light/10 text-center text-sm text-light/50">
      <a href="/about" class="hover:text-accent transition">About Us</a>
      <span class="mx-4">·</span>
      <a href="/terms" class="hover:text-accent transition">Terms &amp; Conditions</a>
      <span class="mx-4">·</span>
      <a href="/privacy" class="hover:text-accent transition">Privacy Policy</a>
      <span class="mx-4">·</span>
      <a href="https://www.instagram.com/ulsaham_?igsh=MTFsdzF4d2J5YXdzdQ==" target="_blank" rel="noreferrer" class="hover:text-accent transition">Instagram</a>
      <span class="mx-4">·</span>
      <a href="https://mail.google.com/mail/?view=cm&to=ulsaham1@gmail.com" target="_blank" rel="noreferrer" class="hover:text-accent transition">Email</a>
      <span class="mx-4">·</span>
      <a href="https://wa.me/9446266011" target="_blank" rel="noreferrer" class="hover:text-accent transition">WhatsApp</a>
    </footer>

  </div>
</BaseLayout>
