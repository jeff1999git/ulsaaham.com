---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScene from "../components/HeroScene.jsx";
import HomeEvents from "../components/HomeEvents.jsx";

const clientLogos = [
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762623295/shakespeares_feast_dh3aqb.png",
    alt: "Shakespeare's Feast logo"
  },
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762622819/casino_logo_g8bajh.png",
    alt: "Casino event collaborators logo"
  },
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762622817/Picsart_25-10-20_19-24-05-046_e4pgxi.png",
    alt: "Neon nights entertainment logo"
  },
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762622817/binin_logo_white_d5vs0r.png",
    alt: "Binin hospitality partners logo"
  },
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762654440/dj_shine_logo_a9lpvq.png",
    alt: "DJ Shine entertainment logo"
  },
  {
    src: "https://res.cloudinary.com/dscbuwvgg/image/upload/v1762654440/bloomtales_by_christina_ina2n6.png",
    alt: "Bloomtales by Christina logo"
  }
];
---

<BaseLayout title="Ulsaaham Celebrations | Immersive Events Crafted to Perfection">
  <section class="hero-video">
    <video
      class="hero-video__media"
      src="/assets/bg_video.mp4"
      autoplay
      muted
      loop
      playsinline
    ></video>
    <div class="hero-video__overlay"></div>
    <nav class="hero-video__menu">
      <a class="hero-video__menu-link" href="/events">Events</a>
      <a class="hero-video__menu-link" href="#testimonials">Partners</a>
      <a class="hero-video__menu-link" href="#overview">About Us</a>
      <a class="hero-video__menu-link" href="#consult">Contact</a>
      <a id="hero-auth" class="hero-video__menu-link" href="/login">Login</a>
    </nav>
    <script>
      const u = JSON.parse(localStorage.getItem("ulsaaham_user") || "null");
      const el = document.getElementById("hero-auth");
      if (el && u) { el.textContent = "Account"; el.href = "/account"; }
    </script>
    <div class="hero-video__content">
      <a class="hero-video__cta" href="#gallery">
        <span class="hero-video__eyebrow">ULSAAHAM</span>
        <h1 class="hero-video__title">Entertainments</h1>
      </a>
    </div>
    <a class="scroll-indicator" href="#gallery">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <section class="bg-primary py-24 text-light" id="gallery">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="section-title">Our Events</h2>
          <p class="section-subtitle max-w-xl">
            Upcoming events you can be part of.
          </p>
        </div>
        <a
          href="/events"
          class="inline-flex items-center rounded-full border border-light/40 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-light/80 transition hover:border-light hover:text-light"
        >
          View All Events
        </a>
      </div>
      <HomeEvents client:load />
    </div>
  </section>

  <section class="bg-primary py-24 text-light" id="testimonials">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="section-title">Our Partners</h2>
        <p class="section-subtitle">
          Partners and brands who trusted us.
        </p>
      </div>
      <div class="client-carousel">
        <div class="client-carousel__track">
          {[...clientLogos, ...clientLogos].map((logo, index) => (
            <div
              class="client-carousel__item"
              aria-hidden={index >= clientLogos.length ? "true" : "false"}
            >
              <img src={logo.src} alt={logo.alt} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative bg-primary py-24 text-light" id="overview">
    <div class="profile-scene">
      <div class="hero-scene-wrapper">
        <HeroScene client:only="react" />
      </div>
    </div>
    <div class="relative z-10 mx-auto max-w-6xl px-6 py-12 lg:px-10">
      <div class="relative flex flex-col gap-10 animate-fade-up lg:flex-row lg:items-start lg:gap-16">
        <div class="flex-1 space-y-8 text-light/85">
          <div class="space-y-5">
            <img
              src="https://res.cloudinary.com/dscbuwvgg/image/upload/v1762587370/Adobe_Express_-_file_1_fvilwg.png"
              alt="Ulsaaham Celebrations logo"
              class="overview-logo"
              loading="lazy"
              decoding="async"
            />
            <p class="inline-flex items-center rounded-full border border-light/30 bg-light/10 px-4 py-1 text-sm font-semibold uppercase tracking-[0.3em] text-light/80">
              Celebrations & Event Planners
            </p>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-semibold uppercase tracking-[0.2em] text-accent">Mission</h3>
            <p>To provide expert and professional event coordination, where every client feels like a guest at their own event, enjoying every moment while we handle every detail.</p>
          </div>
          <div class="space-y-4">
            <h3 class="text-xl font-semibold uppercase tracking-[0.2em] text-accent">Vision</h3>
            <p>To craft extraordinary celebrations that go beyond expectations and create unforgettable experiences filled with joy, creativity, and lasting memories for every guest and client.</p>
          </div>
        </div>
        <div class="hidden h-full w-px self-stretch bg-light/20 mix-blend-screen lg:block"></div>
        <div class="flex-1 space-y-4 text-base leading-relaxed text-light/90">
          <h2 class="text-2xl font-semibold uppercase tracking-[0.25em] text-accent">About Us</h2>
          <p>
            Ulsaaham Celebrations & Event Planners is a Thrissur-based venture created by a team of young, energetic minds who believe that celebrations should feel extraordinary. We don't just plan events—we design experiences.
          </p>
          <p>
            Today, many parties and functions feel routine, predictable, and stressful for the hosts. At Ulsaaham, we change that. We bring creativity, technical precision, and high-energy entertainment to every occasion, making sure the event is not just organized—but felt.
          </p>
          <p>
            From DJ nights, neon parties, theme-based celebrations, Halloween shows, college fests, corporate functions, and nightlife events, to premium collaborations with Hotel, we specialize in creating moments full of excitement, music, and unforgettable ambience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-primary py-24 text-light" id="consult">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(254,204,1,0.12),_transparent)] opacity-70 animate-gradient-x"></div>
      <div class="absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-primary via-primary/90 to-transparent"></div>
      <div class="absolute right-10 top-10 h-48 w-48 rounded-full bg-accent/35 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-5xl px-6 text-center">
      <p class="animate-fade-up text-sm uppercase tracking-[0.4em] text-light/70">Your Celebration, Elevated</p>
      <h2 class="section-title animate-fade-up animation-delay-200 mt-4">
        Ready to choreograph a celebration<br />that feels like a cinematic experience?
      </h2>
      <p class="section-subtitle animate-fade-up animation-delay-300">
        We guide you from inspiration to applause. Share your vision, and our creative producers will craft a bespoke blueprint within 72 hours.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
        <a
          href="mailto:contactulsaaham@gmail.com"
          class="inline-flex items-center justify-center rounded-full bg-accent px-8 py-3 text-base font-semibold text-primary shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:scale-[1.04] hover:bg-accent/80"
        >
          contactulsaaham@gmail.com
        </a>
        <a
          href="https://wa.me/9446266011"
          class="inline-flex items-center justify-center rounded-full border border-light/40 px-8 py-3 text-base font-semibold text-light/85 transition-transform duration-300 hover:-translate-y-1 hover:border-light hover:text-light"
        >
          Schedule a WhatsApp consult →
        </a>
      </div>
    </div>
  </section>

  <footer class="bg-primary py-12 text-light">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.4em] text-light/60">Ulsaaham Celebrations & Event Planners</p>
        <p class="mt-2 text-sm text-light/70">"You celebrate. We create."</p>
      </div>
      <div class="flex gap-6 text-sm text-light/70">
        <a href="/events" class="transition hover:text-accent">Events</a>
        <a href="#testimonials" class="transition hover:text-accent">Partners</a>
        <a href="#overview" class="transition hover:text-accent">About Us</a>
        <a href="/ticket" class="transition hover:text-accent">Check Ticket</a>
        <a href="https://www.instagram.com/ulsaaham_?igsh=MTFsdzF4d2J5YXdzdQ==" target="_blank" rel="noreferrer" class="transition hover:text-accent">Instagram</a>
        <a href="https://wa.me/9446266011" target="_blank" rel="noreferrer" class="transition hover:text-accent">WhatsApp</a>
        <a href="mailto:contactulsaaham@gmail.com" class="transition hover:text-accent">Email</a>
      </div>
    </div>
    <div class="mt-10 border-t border-light/20 pt-6 text-center text-xs text-light/50">
      © {new Date().getFullYear()} Ulsaaham Celebrations and Event Planners
    </div>
  </footer>

</BaseLayout>
