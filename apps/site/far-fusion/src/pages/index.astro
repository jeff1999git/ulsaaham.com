---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "@astrojs/image/components";
import "photoswipe/style.css";

const experiences = [
  {
    title: "Weddings & Engagements",
    description:
      "Curated ceremonies, immersive receptions, and unforgettable after-parties tailored to your story.",
    icon: "💍"
  },
  {
    title: "Luxury Social Affairs",
    description:
      "Milestone birthdays, anniversaries, and private celebrations elevated with sensory details and signature flair.",
    icon: "🎉"
  },
  {
    title: "Corporate & Brand Events",
    description:
      "Product launches, galas, and retreats designed to spark connection and deliver measurable impact.",
    icon: "🏢"
  }
];

const gallery = [
  {
    src: "https://images.unsplash.com/photo-1529634898388-84d3e7f6c58b?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1529634898388-84d3e7f6c58b?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Candlelit outdoor dinner table setting."
  },
  {
    src: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Elegant wedding reception with floral centerpieces."
  },
  {
    src: "https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Corporate celebration with dramatic lighting."
  },
  {
    src: "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1527529482837-4698179dc6ce?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Dessert table with bespoke cake and pastries."
  },
  {
    src: "https://images.unsplash.com/photo-1445452916036-9022dfd33aa8?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1445452916036-9022dfd33aa8?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Live band performing on stage for guests."
  },
  {
    src: "https://images.unsplash.com/photo-1529158062015-cad636e69505?auto=format&fit=crop&w=1600&q=80",
    thumb: "https://images.unsplash.com/photo-1529158062015-cad636e69505?auto=format&fit=crop&w=600&q=60",
    width: 1600,
    height: 1067,
    alt: "Luxury rooftop cocktail hour at sunset."
  }
];

const testimonials = [
  {
    quote:
      "Ulsaaham transformed our rooftop into a dreamscape. Every moment carried intention, from the fragrance in the air to the way guests were guided through the evening.",
    name: "Anisha & Dev",
    role: "Destination Wedding, Goa 2025"
  },
  {
    quote:
      "Our brand launch needed to be bold, fresh, and memorable—Ulsaaham delivered a multi-sensory experience that had partners talking for weeks.",
    name: "Rohit Sharma",
    role: "VP Marketing, Luma Drinks"
  }
];
---

<BaseLayout title="Ulsaaham Celebrations | Immersive Events Crafted to Perfection">
  <section class="hero-video">
    <video
      class="hero-video__media"
      src="/assets/bg_video.mp4"
      autoplay
      muted
      loop
      playsinline
      poster="/assets/bg_video.mp4"
    ></video>
    <div class="hero-video__overlay"></div>
    <a class="hero-video__contact" href="#consult">Contact</a>
    <div class="hero-video__content">
      <a class="hero-video__cta" href="#overview">
        <span class="hero-video__eyebrow">ULSAAHAM</span>
        <h1 class="hero-video__title">Celebrations &<br />Event Planners</h1>
      </a>
    </div>
    <a class="scroll-indicator" href="#overview">
      <span aria-hidden="true"></span>
    </a>
  </section>

  <section class="bg-primary py-24 text-light" id="overview">
    <div class="mx-auto flex max-w-6xl flex-col gap-12 px-6 lg:flex-row lg:items-center">
      <div class="flex-1 space-y-6 animate-fade-up">
        <img
          src="https://res.cloudinary.com/dscbuwvgg/image/upload/v1762587370/Adobe_Express_-_file_1_fvilwg.png"
          alt="Ulsaaham Celebrations logo"
          class="overview-logo"
          loading="lazy"
          decoding="async"
        />
        <p class="inline-flex items-center rounded-full border border-light/30 bg-light/10 px-4 py-1 text-sm font-semibold uppercase tracking-[0.3em] text-light/80">
          Celebrations & Events
        </p>
        <h2 class="section-title text-4xl lg:text-5xl">
          Ulsaaham curates immersive experiences that linger long after the last song.
        </h2>
        <p class="section-subtitle">
          We choreograph every sensory detail across weddings, luxury socials, and corporate milestones—crafting atmospheres where your story and guests take center stage.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="#consult"
            class="inline-flex items-center justify-center rounded-full bg-accent px-7 py-3 font-semibold text-primary shadow-glow transition-transform duration-300 hover:-translate-y-1 hover:scale-105 hover:bg-accent/80"
          >
            Plan My Celebration
          </a>
          <a
            href="#gallery"
            class="inline-flex items-center justify-center rounded-full border border-light/40 px-7 py-3 font-semibold text-light/80 transition duration-300 hover:-translate-y-1 hover:border-light hover:text-light"
          >
            View Signature Moments
          </a>
        </div>
        <dl class="metric-grid">
          <div class="metric-card">
            <dt>Events produced</dt>
            <dd>120+</dd>
          </div>
          <div class="metric-card">
            <dt>Cities served</dt>
            <dd>14</dd>
          </div>
        </dl>
      </div>
      <div class="flex-1 animate-fade-up animation-delay-200">
        <div class="relative overflow-hidden rounded-3xl border border-light/10 bg-primary/80 text-light shadow-xl">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.08),_transparent)]"></div>
          <div class="relative p-8">
            <p class="text-sm font-semibold uppercase tracking-[0.3em] text-accent">Signature Scene</p>
            <p class="mt-4 text-lg font-medium text-light/90">
              “We wanted a space that unfolded like a dream. Ulsaaham orchestrated a glow-soaked celebration that our guests can’t stop talking about.”
            </p>
            <p class="mt-6 text-sm font-semibold text-accent">Nirali + Vikram</p>
            <p class="text-xs text-light/70">Sufi Disco Reception, Jaipur</p>
          </div>
          <div class="h-48 overflow-hidden rounded-t-3xl border-t border-light/10 bg-primary/70 lg:h-56">
            <Image
              src="https://images.unsplash.com/photo-1489515217757-5fd1be406fef?auto=format&fit=crop&w=1400&q=80"
              alt="Immersive light-filled event dance floor."
              width={980}
              height={640}
              class="h-full w-full object-cover"
              format="webp"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-primary py-24 text-light" id="experiences">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="section-title text-3xl sm:text-4xl">Crafted for your most meaningful moments</h2>
        <p class="section-subtitle">
          Every celebration is built around your story, your guests, and the emotions you want them to carry home.
        </p>
      </div>
      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {experiences.map((experience, index) => (
          <article
            style={`animation-delay: ${(index * 0.15 + 0.1).toFixed(2)}s`}
            class="experience-card group flex h-full animate-fade-up flex-col transition-all duration-500 hover:-translate-y-3"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/15 text-2xl text-accent transition group-hover:scale-110 group-hover:bg-accent/25">
              {experience.icon}
            </span>
            <h3 class="mt-6 font-serif text-2xl">{experience.title}</h3>
            <p class="mt-3 text-base">{experience.description}</p>
            <span class="mt-auto pt-6 text-sm font-semibold uppercase tracking-[0.2em] text-accent transition group-hover:text-primary">
              Discover More
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="relative bg-primary py-24 text-light">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(254,204,1,0.18),_transparent)]"></div>
    <div class="relative mx-auto max-w-6xl px-6 text-center">
      <p class="animate-fade-up text-sm uppercase tracking-[0.4em] text-accent">Our Philosophy</p>
      <h2 class="section-title animate-fade-up animation-delay-200 mt-4 text-3xl sm:text-4xl">Immersion, emotion, intention.</h2>
      <p class="section-subtitle animate-fade-up animation-delay-300">
        We pair imaginative design with flawless production to craft journeys that feel effortless. Moodboards become moments, budgets remain protected, and our team holds the reins from concept to encore.
      </p>
      <dl class="mt-12 grid gap-8 sm:grid-cols-3">
        <div
          style="animation-delay: 0.15s"
          class="animate-fade-up rounded-3xl border border-light/10 bg-light/5 p-6 backdrop-blur transition hover:-translate-y-2 hover:border-light/30 hover:bg-light/10"
        >
          <dt class="text-sm uppercase tracking-wide text-accent">01 / Discovery</dt>
          <dd class="mt-3 text-base text-light/80">Immersive consultation, mood exploration, and experience mapping.</dd>
        </div>
        <div
          style="animation-delay: 0.3s"
          class="animate-fade-up rounded-3xl border border-light/10 bg-light/5 p-6 backdrop-blur transition hover:-translate-y-2 hover:border-light/30 hover:bg-light/10"
        >
          <dt class="text-sm uppercase tracking-wide text-accent">02 / Design</dt>
          <dd class="mt-3 text-base text-light/80">Narrative-led design concepts, spatial planning, talent sourcing, and tech choreography.</dd>
        </div>
        <div
          style="animation-delay: 0.45s"
          class="animate-fade-up rounded-3xl border border-light/10 bg-light/5 p-6 backdrop-blur transition hover:-translate-y-2 hover:border-light/30 hover:bg-light/10"
        >
          <dt class="text-sm uppercase tracking-wide text-accent">03 / Production</dt>
          <dd class="mt-3 text-base text-light/80">On-site direction, guest pathing, run-of-show, and post-event storytelling assets.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="bg-primary py-24 text-light" id="gallery">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
        <div>
          <h2 class="section-title text-3xl sm:text-4xl">Signature moments</h2>
          <p class="section-subtitle max-w-xl">
            A peek into the kaleidoscope of celebrations curated with our clients. Tap to step inside each story.
          </p>
        </div>
        <a
          href="#consult"
          class="inline-flex items-center rounded-full border border-light/40 px-6 py-3 text-sm font-semibold uppercase tracking-[0.3em] text-light/80 transition hover:border-light hover:text-light"
        >
          Build My Vision
        </a>
      </div>
      <div id="event-gallery" class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gallery.map((image, index) => (
          <a
            href={image.src}
            data-pswp-width={image.width}
            data-pswp-height={image.height}
            target="_blank"
            rel="noreferrer"
            style={`animation-delay: ${(index * 0.1 + 0.2).toFixed(2)}s`}
            class="gallery-card group animate-fade-up transition-all duration-500 hover:-translate-y-2"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <Image
                src={image.thumb}
                alt={image.alt}
                width={600}
                height={450}
                class="h-full w-full object-cover transition duration-700 group-hover:scale-110"
                format="webp"
              />
              <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle,_rgba(254,204,1,0.22)_0%,_rgba(2,51,1,0.65)_100%)] opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
              <div class="pointer-events-none absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-light/40 to-transparent opacity-0 transition duration-700 group-hover:translate-x-full group-hover:opacity-100"></div>
            </div>
            <p class="absolute bottom-4 left-4 rounded-full bg-light px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-primary shadow">
              View Story
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-primary py-24 text-light" id="testimonials">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="section-title text-3xl sm:text-4xl">Stories we still replay</h2>
        <p class="section-subtitle">Intimate notes from the people who trusted us with unforgettable nights.</p>
      </div>
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {testimonials.map((testimonial, index) => (
          <blockquote
            style={`animation-delay: ${(index * 0.15 + 0.2).toFixed(2)}s`}
            class="testimonial-card animate-fade-up"
          >
            <p>“{testimonial.quote}”</p>
            <footer class="mt-6">
              <p class="text-base font-semibold text-primary">{testimonial.name}</p>
              <p class="text-sm uppercase tracking-[0.25em] text-primary/60">{testimonial.role}</p>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-primary py-24 text-light" id="consult">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(254,204,1,0.12),_transparent)] opacity-70 animate-gradient-x"></div>
      <div class="absolute inset-x-0 bottom-0 h-72 bg-gradient-to-t from-primary via-primary/90 to-transparent"></div>
      <div class="absolute right-10 top-10 h-48 w-48 rounded-full bg-accent/35 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-5xl px-6 text-center">
      <p class="animate-fade-up text-sm uppercase tracking-[0.4em] text-light/70">Your Celebration, Elevated</p>
      <h2 class="section-title animate-fade-up animation-delay-200 mt-4 text-3xl sm:text-4xl">
        Ready to choreograph a celebration<br />that feels like a cinematic experience?
      </h2>
      <p class="section-subtitle animate-fade-up animation-delay-300">
        We guide you from inspiration to applause. Share your vision, and our creative producers will craft a bespoke blueprint within 72 hours.
      </p>
      <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
        <a
          href="mailto:contactulsaaham@gmail.com"
          class="inline-flex items-center justify-center rounded-full bg-accent px-8 py-3 text-base font-semibold text-primary shadow-lg transition-transform duration-300 hover:-translate-y-1 hover:scale-[1.04] hover:bg-accent/80"
        >
          contactulsaaham@gmail.com
        </a>
        <a
          href="https://wa.me/9446266011"
          class="inline-flex items-center justify-center rounded-full border border-light/40 px-8 py-3 text-base font-semibold text-light/85 transition-transform duration-300 hover:-translate-y-1 hover:border-light hover:text-light"
        >
          Schedule a WhatsApp consult →
        </a>
      </div>
    </div>
  </section>

  <footer class="bg-primary py-12 text-light">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.4em] text-light/60">Ulsaaham Celebrations</p>
        <p class="mt-2 text-sm text-light/70">Immersive celebrations & experiential storytelling across India and beyond.</p>
      </div>
      <div class="flex gap-6 text-sm text-light/70">
        <a href="https://www.instagram.com/ulsaaham_?igsh=MTFsdzF4d2J5YXdzdQ==" target="_blank" rel="noreferrer" class="transition hover:text-accent">Instagram</a>
        <a href="https://wa.me/9446266011" target="_blank" rel="noreferrer" class="transition hover:text-accent">WhatsApp</a>
        <a href="mailto:contactulsaaham@gmail.com" class="transition hover:text-accent">Email</a>
      </div>
    </div>
    <div class="mt-10 border-t border-light/20 pt-6 text-center text-xs text-light/50">
      © {new Date().getFullYear()} Ulsaaham Collective. Crafted with intention.
    </div>
  </footer>

  <script type="module">
    import PhotoSwipeLightbox from "photoswipe/lightbox";
    import "photoswipe/style.css";

    const lightbox = new PhotoSwipeLightbox({
      gallery: "#event-gallery",
      children: "a",
      pswpModule: () => import("photoswipe")
    });

    lightbox.init();
  </script>
</BaseLayout>

