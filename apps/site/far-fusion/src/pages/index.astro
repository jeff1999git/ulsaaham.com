---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import HomeEventsSection from "../components/HomeEventsSection.jsx";
import BrandPartners from "../components/BrandPartners.jsx";
import ApiPrefetch from "../components/ApiPrefetch.astro";
import { HOME_PREFETCH } from "../lib/page-data.js";

// Hero clips on Cloudinary, capped in width and at eco quality. Each poster is
// the clip's frame at 1 s (the very first frame can be black).
const CLD_VIDEO = "https://res.cloudinary.com/dk26ldwpu/video/upload";
const HERO_MOBILE = { id: "v1781283333/Boobu_Dj_Boobu_Djboobu_Thrissur_Kerala_Dj_Boobu_kf7rs0", width: 720 };
const HERO_DESKTOP = { id: "v1781270617/landscape_takqtx", width: 1280 };
const heroVideo = ({ id, width }) => `${CLD_VIDEO}/f_auto,q_auto:eco,vc_auto,w_${width}/${id}.webm`;
const heroPoster = ({ id, width }) => `${CLD_VIDEO}/so_1,f_auto,q_auto,w_${width}/${id}.jpg`;
---

<BaseLayout title="Ulsaham Entertainments | Immersive Events Crafted to Perfection" canonical>
  <Fragment slot="head">
    {/* The poster is the hero's first paint; each one preloads only on the
        screens that show it (same breakpoint as the videos in global.css). */}
    <link rel="preload" as="image" fetchpriority="high" media="(max-width: 768px)" href={heroPoster(HERO_MOBILE)} />
    <link rel="preload" as="image" fetchpriority="high" media="(min-width: 769px)" href={heroPoster(HERO_DESKTOP)} />
    {/* The events and partners data for slides 2 and 3, requested now so it
        is ready when their islands hydrate at idle. */}
    <ApiPrefetch paths={HOME_PREFETCH} />
  </Fragment>
  <SiteNav
    links={[
      { href: "#gallery", label: "Events" },
      { href: "#testimonials", label: "Partners" },
      { href: "#connect", label: "Connect" },
    ]}
  >
    <button id="hero-sound-toggle" class="hero-sound-toggle" aria-label="Unmute video">
      <svg id="hero-sound-off" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
      <svg id="hero-sound-on" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
    </button>
  </SiteNav>

  <div id="fp-viewport" class="fp-viewport">
    <div id="fp-wrap" class="fp-wrap">

      <div class="fp-section is-current">
        <section class="hero-video">
          <video
            class="hero-video__media hero-video__media--desktop"
            data-src={heroVideo(HERO_DESKTOP)}
            data-poster={heroPoster(HERO_DESKTOP)}
            preload="none"
            muted
            loop
            playsinline
          ></video>
          <video
            class="hero-video__media hero-video__media--mobile"
            data-src={heroVideo(HERO_MOBILE)}
            data-poster={heroPoster(HERO_MOBILE)}
            preload="none"
            muted
            loop
            playsinline
          ></video>
          <script is:inline>
            // Only the clip for this screen size loads: the one CSS hides never
            // gets a src or a poster. Its poster shows first; under Save-Data or
            // on 2G the poster stays and the clip is not fetched. window.ulsHero
            // is shared with the sound button and with the slide pager, which
            // pauses the clip whenever the first slide is off screen.
            (function () {
              var mq = window.matchMedia("(max-width: 768px)");
              var conn = navigator.connection;
              var hero = {
                video: null,
                // A link straight to another slide (#gallery…) waits for the
                // pager to say which slide is on screen.
                active: !location.hash,
                posterOnly: !!(conn && (conn.saveData || /2g/.test(conn.effectiveType || ""))),
                sync: function () {
                  var v = hero.video;
                  if (!v) return;
                  if (!hero.active || hero.posterOnly) { v.pause(); return; }
                  if (!v.getAttribute("src")) v.src = v.getAttribute("data-src");
                  var p = v.play();
                  if (p && p.catch) p.catch(function () {});
                },
                setActive: function (on) {
                  hero.active = on;
                  hero.sync();
                },
              };
              function pick() {
                var next = document.querySelector(mq.matches ? ".hero-video__media--mobile" : ".hero-video__media--desktop");
                var prev = hero.video;
                if (!next || next === prev) return;
                // Crossing the breakpoint swaps clips; the sound setting carries over.
                if (prev) {
                  next.muted = prev.muted;
                  prev.muted = true;
                  prev.pause();
                }
                if (!next.getAttribute("poster")) next.setAttribute("poster", next.getAttribute("data-poster"));
                hero.video = next;
                hero.sync();
              }
              window.ulsHero = hero;
              pick();
              if (mq.addEventListener) mq.addEventListener("change", pick);
              else if (mq.addListener) mq.addListener(pick);
            })();
          </script>
          <div class="hero-quote">
            <p class="hero-quote__text">"Entertainment is Pure Experience"</p>
            <a href="#gallery" id="hero-explore-btn" class="hero-explore-btn">
              <span id="hero-explore-btn__label" class="hero-explore-btn__label">Explore Events</span>
              <svg class="hero-explore-btn__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
            </a>
          </div>

          <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
              var items = [
                { label: "Explore Events", href: "#gallery" },
                { label: "Explore Partners", href: "#testimonials" },
                { label: "Connect With Us", href: "#connect" },
              ];
              var link = document.getElementById("hero-explore-btn");
              var label = document.getElementById("hero-explore-btn__label");
              if (!link || !label) return;
              var slide = link.closest(".fp-section");
              var i = 0;
              setInterval(function () {
                // Only rotates while the first slide is on screen.
                if (slide && !slide.classList.contains("is-current")) return;
                i = (i + 1) % items.length;
                label.style.opacity = "0";
                setTimeout(function () {
                  label.textContent = items[i].label;
                  link.setAttribute("href", items[i].href);
                  label.style.opacity = "1";
                }, 250);
              }, 3000);
            });
          </script>

          <a href="#gallery" class="hero-scroll-hint" aria-label="Scroll to events">
            <span class="nav-chevrons" aria-hidden="true">
              <svg class="nav-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="11" viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 2 12 12 22 2"/></svg>
              <svg class="nav-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="11" viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 2 12 12 22 2"/></svg>
              <svg class="nav-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="11" viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 2 12 12 22 2"/></svg>
              <svg class="nav-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="11" viewBox="0 0 24 14" fill="none" stroke="currentColor" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 2 12 12 22 2"/></svg>
            </span>
          </a>

          <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
              var btn = document.getElementById("hero-sound-toggle");
              var iconOff = document.getElementById("hero-sound-off");
              var iconOn = document.getElementById("hero-sound-on");
              var hero = window.ulsHero;
              if (!btn || !hero) return;
              // Only the clip on screen is ever unmuted; the other stays muted
              // and paused.
              btn.addEventListener("click", function () {
                var v = hero.video;
                if (!v) return;
                var wasMuted = v.muted;
                v.muted = !wasMuted;
                if (wasMuted) {
                  // Asking for sound is asking for the clip, even where only
                  // the poster was loaded (Save-Data, 2G).
                  hero.posterOnly = false;
                  hero.sync();
                }
                iconOff.style.display = wasMuted ? "none" : "";
                iconOn.style.display = wasMuted ? "" : "none";
                btn.setAttribute("aria-label", wasMuted ? "Mute video" : "Unmute video");
              });
            });
          </script>
        </section>
      </div>

      <div class="fp-section">
        <section class="pt-16 sm:pt-24 pb-6 md:pb-10 text-light relative isolate z-10" id="gallery">
          {/* Off screen at load, so they hydrate once the hero has settled
              (1.5 s at the latest); their data is already on its way. */}
          <HomeEventsSection client:idle={{ timeout: 1500 }} />
        </section>
      </div>

      <div class="fp-section">
        <BrandPartners client:idle={{ timeout: 1500 }} />
      </div>

      <div class="fp-section">
        <section class="relative isolate overflow-hidden flex flex-col py-8 md:py-12 text-light z-10 border-t border-white/10" id="connect">
          <div class="absolute inset-0">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(155,202,59,0.10),_transparent)]"></div>
            <div class="absolute right-10 top-10 h-48 w-48 rounded-full bg-accent/20 blur-3xl"></div>
          </div>
          <div class="relative flex-1 flex flex-col items-center justify-center mx-auto max-w-5xl px-4 sm:px-6 text-center">
            <p class="animate-fade-up text-sm font-bold uppercase tracking-[0.4em] text-light/90">Connect With Us</p>
            <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
              <a
                href="https://mail.google.com/mail/?view=cm&to=ulsaham1@gmail.com"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-semibold text-accent transition-transform duration-300 hover:-translate-y-1 hover:scale-[1.04]"
                style="background: rgba(155,202,59,0.12); border: 1px solid rgba(155,202,59,0.4);"
              >
                ulsaham1@gmail.com
              </a>
              <a
                href="https://wa.me/919446266011"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center justify-center rounded-full px-8 py-3 text-base font-semibold transition-transform duration-300 hover:-translate-y-1 hover:scale-[1.04]"
                style="background: rgba(37,211,102,0.12); border: 1px solid rgba(37,211,102,0.4); color: rgb(37,211,102);"
              >
                WhatsApp →
              </a>
            </div>
          </div>

          <footer class="relative z-10 mt-6 pt-6 border-t border-white/10">
            <div class="mx-auto flex max-w-6xl justify-center px-6">
              <div class="flex flex-wrap justify-center gap-6 text-sm text-light/70">
                <a href="/about" class="transition hover:text-accent">About Us</a>
                <a href="https://www.instagram.com/ulsaham_?igsh=MTFsdzF4d2J5YXdzdQ==" target="_blank" rel="noreferrer" class="transition hover:text-accent">Instagram</a>
                <a href="/privacy" class="transition hover:text-accent">Privacy Policy</a>
                <a href="/terms" class="transition hover:text-accent">Terms &amp; Conditions</a>
              </div>
            </div>
            <div class="mt-4 text-center text-xs text-light/50">
              {/* The page is built ahead of time, so the year is set again in
                  the browser; the build year shows only without script. */}
              © <span id="footer-year">{new Date().getFullYear()}</span> Ulsaham Entertainments
              <script is:inline>document.getElementById("footer-year").textContent = new Date().getFullYear();</script>
            </div>
          </footer>
        </section>
      </div>

    </div>

    <div class="fp-dots" id="fp-dots">
      <button type="button" class="fp-dot" aria-label="Go to landing"></button>
      <button type="button" class="fp-dot" aria-label="Go to events"></button>
      <button type="button" class="fp-dot" aria-label="Go to partners"></button>
      <button type="button" class="fp-dot" aria-label="Go to connect"></button>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      var wrap = document.getElementById("fp-wrap");
      var sections = Array.from(document.querySelectorAll(".fp-section"));
      var dots = Array.from(document.querySelectorAll(".fp-dot"));
      if (!wrap || !sections.length) return;

      var anchorIndex = { "#gallery": 1, "#testimonials": 2, "#connect": 3 };
      var current = 0;
      var animating = false; // true while the slide transition is actually running
      var gestureLocked = false; // true from the moment a gesture triggers a nav until the whole gesture has ended
      var gestureIdleTimer = null;

      function render() {
        wrap.style.transform = "translateY(-" + (current * (100 / sections.length)) + "%)";
        dots.forEach(function (d, i) { d.classList.toggle("is-active", i === current); });
        // Off-screen slides hold their endless animations (global.css), and
        // the hero clip only plays on the first slide.
        sections.forEach(function (s, i) { s.classList.toggle("is-current", i === current); });
        if (window.ulsHero) window.ulsHero.setActive(current === 0);
      }

      function goTo(index) {
        index = Math.max(0, Math.min(sections.length - 1, index));
        if (index === current) return;
        current = index;
        animating = true;
        render();
        window.setTimeout(function () { animating = false; }, 800);
      }

      // A single physical scroll gesture (a trackpad swipe, or a finger dragging
      // on a touchscreen) fires many wheel/touchmove events in a row. Keep pushing
      // the release out on every one of them so the whole gesture only ever
      // advances one page — never resolves until both the transition has finished
      // AND the input has gone quiet for a beat.
      function armGestureRelease() {
        clearTimeout(gestureIdleTimer);
        gestureIdleTimer = setTimeout(function release() {
          if (animating) { gestureIdleTimer = setTimeout(release, 100); return; }
          gestureLocked = false;
        }, 150);
      }

      function tryAdvance(dir) {
        if (dir > 0 && current === sections.length - 1) return; // already on the last slide, no-op
        if (dir < 0 && current === 0) return; // already on the first slide, no-op
        gestureLocked = true;
        goTo(current + dir);
        armGestureRelease();
      }

      if (location.hash && anchorIndex[location.hash] != null) {
        current = anchorIndex[location.hash];
      }
      render();

      // Pinch-zoomed in: fingers and the wheel pan the zoomed page, so the
      // pager keeps out of the way until it is zoomed back out.
      function zoomed() {
        return !!window.visualViewport && window.visualViewport.scale > 1.01;
      }

      window.addEventListener(
        "wheel",
        function (e) {
          // A trackpad pinch (ctrlKey) or a sideways swipe is not a request to
          // change slides; left alone, the browser zooms or goes back/forward.
          if (e.ctrlKey || zoomed() || Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          if (window.scrollY > 0) return;

          if (gestureLocked) {
            e.preventDefault();
            armGestureRelease();
            return;
          }

          var dir = e.deltaY > 0 ? 1 : -1;
          if (dir > 0 && current === sections.length - 1) return; // let the page do nothing, we're at the end
          e.preventDefault();
          tryAdvance(dir);
        },
        { passive: false }
      );

      var touchStartY = null;
      // Set once a second finger joins the touch (a pinch, never a swipe) and
      // cleared when the last finger lifts.
      var multiTouch = false;
      var SWIPE_THRESHOLD = 40;

      window.addEventListener(
        "touchstart",
        function (e) {
          if (e.touches.length > 1) multiTouch = true;
          if (multiTouch || window.scrollY > 0 || gestureLocked) { touchStartY = null; return; }
          touchStartY = e.touches[0].clientY;
        },
        { passive: true }
      );

      // Stops the page bouncing under a one-finger swipe (iOS needs this
      // listener on window). Two fingers, or a zoomed page, are the browser's.
      window.addEventListener(
        "touchmove",
        function (e) {
          if (touchStartY == null || window.scrollY > 0) return;
          if (e.touches.length > 1 || zoomed()) return;
          e.preventDefault();
        },
        { passive: false }
      );

      function touchDone(e) {
        if (!e.touches || e.touches.length === 0) multiTouch = false;
      }

      window.addEventListener("touchend", function (e) {
        var startY = touchStartY;
        touchStartY = null;
        touchDone(e);
        if (startY == null || zoomed() || window.scrollY > 0) return;
        var endY = e.changedTouches && e.changedTouches[0] ? e.changedTouches[0].clientY : startY;
        var delta = startY - endY; // swiped up (finger moved to a smaller Y) => go to next section
        if (Math.abs(delta) < SWIPE_THRESHOLD || gestureLocked) return;
        tryAdvance(delta > 0 ? 1 : -1);
      });

      window.addEventListener("touchcancel", function (e) {
        touchStartY = null;
        touchDone(e);
      });

      window.addEventListener("keydown", function (e) {
        if (window.scrollY > 0 || animating) return;
        if (e.key === "ArrowDown" || e.key === "PageDown") { e.preventDefault(); goTo(current + 1); }
        else if (e.key === "ArrowUp" || e.key === "PageUp") { e.preventDefault(); goTo(current - 1); }
      });

      // Links to a slide (#gallery…), including ones the islands render later.
      document.addEventListener("click", function (e) {
        var link = e.target instanceof Element ? e.target.closest('a[href^="#"]') : null;
        var idx = link ? anchorIndex[link.getAttribute("href")] : null;
        if (idx == null) return;
        e.preventDefault();
        goTo(idx);
      });

      dots.forEach(function (dot, i) {
        dot.addEventListener("click", function () { goTo(i); });
      });

      // Tabbing onto a link on another slide makes the browser scroll the
      // clipped viewport or slide to reveal it, leaving the slides half
      // shifted and out of step with the dots. Neither box ever scrolls on
      // purpose, so any scroll is undone straight away (a scroll listener
      // runs after the browser's own scroll into view; focusin runs before
      // it) and the pager brings that slide on screen instead.
      [document.getElementById("fp-viewport")].concat(sections).forEach(function (box) {
        if (!box) return;
        box.addEventListener("scroll", function () {
          if (box.scrollTop) box.scrollTop = 0;
          if (box.scrollLeft) box.scrollLeft = 0;
        }, { passive: true });
      });
      // Only focus landing on another slide moves the pager. A tap or click
      // on a link (#gallery…) focuses it on the slide already on screen, and
      // its click then changes slide before the next frame; going back to
      // the focused link's slide there would undo that.
      wrap.addEventListener("focusin", function (e) {
        var i = sections.findIndex(function (s) { return s.contains(e.target); });
        if (i < 0 || i === current) return;
        var from = current;
        requestAnimationFrame(function () { if (current === from) goTo(i); });
      });
    });
  </script>

</BaseLayout>
