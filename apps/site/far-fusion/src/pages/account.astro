---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import AccountPage from "../components/AccountPage.jsx";
---

<BaseLayout title="My Account — Ulsaham" description="View your profile and bookings." noindex>
  <div class="min-h-screen bg-primary text-light">

    <SiteNav avatarHref="/account" />

    <div class="mx-auto max-w-4xl px-4 sm:px-6 pt-16 sm:pt-24 pb-14 md:pb-24">
      <AccountPage client:load />
    </div>

  </div>
</BaseLayout>
