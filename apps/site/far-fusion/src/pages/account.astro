---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import AccountPage from "../components/AccountPage.jsx";
---

<BaseLayout title="My Account — Ulsaham" description="View your profile and tickets.">
  <div class="min-h-screen bg-primary text-light">

    <header class="page-topbar">
      <div class="mx-auto max-w-6xl px-6 flex items-center justify-between">
        <a href="/" class="page-topbar__brand"><img src="/brand_logo.avif" alt="Ulsaham" class="topbar-logo" /></a>
        <div class="flex items-center gap-5">
          <a href="/events" class="page-topbar__link">Events</a>
          <a id="topbar-auth" href="/account" class="topbar-avatar" aria-label="My Account"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
        </div>
      </div>
    </header>
    <script>
      const u = JSON.parse(localStorage.getItem("ulsaham_user") || "null");
      const el = document.getElementById("topbar-auth");
      if (el && u) { el.innerHTML = `<span class="topbar-avatar__letter">${(u.name||"?")[0].toUpperCase()}</span>`; }
    </script>

    <div class="mx-auto max-w-4xl px-6 pt-14 pb-24">
      <AccountPage client:load />
    </div>

  </div>
</BaseLayout>
