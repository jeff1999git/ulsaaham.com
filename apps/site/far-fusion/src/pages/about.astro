---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroScene from "../components/HeroScene.jsx";
---

<BaseLayout title="About Us — Ulsaham Entertainments" description="Learn about Ulsaham Entertainments — a Thrissur-based team crafting extraordinary event experiences.">
  <div class="min-h-screen bg-primary text-light">

    <nav class="hero-video__menu">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <a href="/" class="hero-logo-link" aria-label="Ulsaham Home">
          <img src="/brand_logo.avif" alt="Ulsaham" class="topbar-logo" />
          <div class="hero-logo-link__brand">
            <span class="hero-logo-link__name">ULSAHAM</span>
            <span class="hero-logo-link__sub">Entertainments</span>
          </div>
        </a>
      </div>
      <div class="hero-video__menu-links">
        <a class="hero-video__menu-link" href="/events">Events</a>
        <a class="hero-video__menu-link" href="/#connect">Connect</a>
        <div class="profile-menu-wrap" id="profile-menu-wrap">
          <a id="hero-auth" class="topbar-avatar" href="/login" aria-label="Login" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
          <div class="mobile-nav-dropdown" id="mobile-nav-dropdown" role="menu">
            <a href="/events" class="mobile-nav-dropdown__link" role="menuitem">Events</a>
            <a href="/#connect" class="mobile-nav-dropdown__link" role="menuitem">Connect</a>
            <div class="mobile-nav-dropdown__divider"></div>
            <a id="mobile-account-link" href="/login" class="mobile-nav-dropdown__link mobile-nav-dropdown__link--account" role="menuitem">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <span id="mobile-account-label">Account</span>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <script>
      const u = JSON.parse(localStorage.getItem("ulsaham_user") || "null");
      const el = document.getElementById("hero-auth");
      const mobileLink = document.getElementById("mobile-account-link");
      const mobileLabel = document.getElementById("mobile-account-label");
      if (el && u) { el.href = "/account"; el.setAttribute("aria-label", "My Account"); el.innerHTML = `<span class="topbar-avatar__letter">${(u.name||"?")[0].toUpperCase()}</span>`; }
      if (mobileLink && u) { mobileLink.href = "/account"; }
      if (mobileLabel && u) { mobileLabel.textContent = `Hi, ${(u.name||"?").split(" ")[0]}`; }
      const wrap = document.getElementById("profile-menu-wrap");
      const dropdown = document.getElementById("mobile-nav-dropdown");
      if (el && wrap && dropdown) {
        el.addEventListener("click", function(e) {
          if (window.innerWidth <= 640) { e.preventDefault(); const open = dropdown.classList.toggle("is-open"); el.setAttribute("aria-expanded", open ? "true" : "false"); }
        });
        dropdown.querySelectorAll(".mobile-nav-dropdown__link").forEach(function(link) {
          link.addEventListener("click", function() { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); });
        });
        document.addEventListener("click", function(e) {
          if (!wrap.contains(e.target)) { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); }
        });
      }
    </script>

    <section class="relative bg-primary pt-16 sm:pt-24 pb-14 md:pb-24 text-light">
      <div class="profile-scene">
        <div class="hero-scene-wrapper">
          <HeroScene client:only="react" />
        </div>
      </div>
      <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 pt-6 pb-8 sm:pb-12 lg:px-10">
        <div class="relative flex flex-col gap-10 animate-fade-up lg:flex-row lg:items-start lg:gap-16">
          <div class="flex-1 space-y-8 text-light/85">
            <div class="space-y-5">
              <img
                src="https://res.cloudinary.com/dscbuwvgg/image/upload/v1762587370/Adobe_Express_-_file_1_fvilwg.png"
                alt="Ulsaham Entertainments logo"
                class="overview-logo"
                loading="lazy"
                decoding="async"
              />
              <p class="inline-flex items-center rounded-full border border-light/30 bg-light/10 px-4 py-1 text-sm font-semibold uppercase tracking-[0.3em] text-light/80">
                Entertainments
              </p>
            </div>
            <div class="space-y-4">
              <h3 class="text-xl font-semibold uppercase tracking-[0.2em] text-accent">Mission</h3>
              <p>To provide expert and professional event coordination, where every client feels like a guest at their own event, enjoying every moment while we handle every detail.</p>
            </div>
            <div class="space-y-4">
              <h3 class="text-xl font-semibold uppercase tracking-[0.2em] text-accent">Vision</h3>
              <p>To craft extraordinary celebrations that go beyond expectations and create unforgettable experiences filled with joy, creativity, and lasting memories for every guest and client.</p>
            </div>
          </div>
          <div class="hidden h-full w-px self-stretch bg-light/20 mix-blend-screen lg:block"></div>
          <div class="flex-1 space-y-4 text-base leading-relaxed text-light/90">
            <h2 class="text-2xl font-semibold uppercase tracking-[0.25em] text-accent">About Us</h2>
            <p>
              Ulsaham Entertainments is a Thrissur-based venture created by a team of young, energetic minds who believe that events should feel extraordinary. We don't just plan events—we design experiences.
            </p>
            <p>
              Today, many parties and functions feel routine, predictable, and stressful for the hosts. At Ulsaham, we change that. We bring creativity, technical precision, and high-energy entertainment to every occasion, making sure the event is not just organized—but felt.
            </p>
            <p>
              From DJ nights, neon parties, theme-based celebrations, Halloween shows, college fests, corporate functions, and nightlife events, to premium collaborations with Hotel, we specialize in creating moments full of excitement, music, and unforgettable ambience.
            </p>
          </div>
        </div>
      </div>
    </section>

    <footer class="bg-primary py-8 border-t border-light/10 text-center text-sm text-light/50">
      <a href="/" class="hover:text-accent transition">← Back to Home</a>
      <span class="mx-4">·</span>
      <a href="/events" class="hover:text-accent transition">Events</a>
      <span class="mx-4">·</span>
      <a href="/privacy" class="hover:text-accent transition">Privacy Policy</a>
    </footer>

  </div>
</BaseLayout>
