---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import EventDetail from "../../components/EventDetail.jsx";
import ApiPrefetch from "../../components/ApiPrefetch.astro";
---

<BaseLayout title="Event Details — Ulsaham Entertainments">
  <ApiPrefetch slot="head" eventSlug />
  <div class="min-h-screen bg-primary text-light">

    <SiteNav />

    <div class="pt-16 sm:pt-24">
      <EventDetail client:load />
    </div>

  </div>
</BaseLayout>
