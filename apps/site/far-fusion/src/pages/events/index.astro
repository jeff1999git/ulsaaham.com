---
export const prerender = true;
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import EventsList from "../../components/EventsList.jsx";
import ApiPrefetch from "../../components/ApiPrefetch.astro";
import { EVENTS_PREFETCH } from "../../lib/page-data.js";
---

<BaseLayout title="Events — Ulsaham Entertainments" description="Discover upcoming events crafted by Ulsaham Entertainments." canonical>
  <ApiPrefetch slot="head" paths={EVENTS_PREFETCH} />
  <div class="min-h-screen bg-primary text-light">

    <SiteNav links={[{ href: "/", label: "Home" }, { href: "/#connect", label: "Connect" }]} />

    <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-14 md:pb-24">
      <div class="mb-12">
        <h1 class="section-title text-3xl">Our Events</h1>
        <p class="section-subtitle">
          Discover upcoming events crafted by Ulsaham Entertainments.
        </p>
      </div>
      <EventsList client:load />
    </div>

  </div>
</BaseLayout>
