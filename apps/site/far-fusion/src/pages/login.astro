---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthForm from "../components/AuthForm.jsx";
---

<BaseLayout title="Login — Ulsaham" description="Sign in or create your Ulsaham account.">
  <div class="min-h-screen bg-primary text-light">

    <nav class="hero-video__menu">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <a href="/" class="hero-logo-link" aria-label="Ulsaham Home">
          <img src="/brand_logo.avif" alt="Ulsaham" class="topbar-logo" />
          <div class="hero-logo-link__brand">
            <span class="hero-logo-link__name">ULSAHAM</span>
            <span class="hero-logo-link__sub">Entertainments</span>
          </div>
        </a>
      </div>
      <div class="hero-video__menu-links">
        <a class="hero-video__menu-link" href="/events">Events</a>
        <a class="hero-video__menu-link" href="/#connect">Connect</a>
      </div>
    </nav>

    <div class="mx-auto max-w-sm px-4 sm:px-6 pt-16 sm:pt-24 pb-16 md:pb-24">
      <h1 class="section-title text-3xl mb-2">Sign In</h1>
      <p class="section-subtitle mb-10">
        Access your tickets and register for events.
      </p>
      <AuthForm client:load />
    </div>

  </div>
</BaseLayout>
