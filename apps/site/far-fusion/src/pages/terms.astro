---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Terms & Conditions — Ulsaham Entertainments" description="Terms and conditions for using Ulsaham Entertainments events and ticketing platform.">
  <div class="min-h-screen bg-primary text-light">

    <nav class="hero-video__menu">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <a href="/" class="hero-logo-link" aria-label="Ulsaham Home">
          <img src="/brand_logo.avif" alt="Ulsaham" class="topbar-logo" />
          <div class="hero-logo-link__brand">
            <span class="hero-logo-link__name">ULSAHAM</span>
            <span class="hero-logo-link__sub">Entertainments</span>
          </div>
        </a>
      </div>
      <div class="hero-video__menu-links">
        <a class="hero-video__menu-link" href="/events">Events</a>
        <a class="hero-video__menu-link" href="/#connect">Connect</a>
        <div class="profile-menu-wrap" id="profile-menu-wrap">
          <a id="hero-auth" class="topbar-avatar" href="/login" aria-label="Login" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
          <div class="mobile-nav-dropdown" id="mobile-nav-dropdown" role="menu">
            <a href="/events" class="mobile-nav-dropdown__link" role="menuitem">Events</a>
            <a href="/#connect" class="mobile-nav-dropdown__link" role="menuitem">Connect</a>
            <div class="mobile-nav-dropdown__divider"></div>
            <a id="mobile-account-link" href="/login" class="mobile-nav-dropdown__link mobile-nav-dropdown__link--account" role="menuitem">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
              <span id="mobile-account-label">Account</span>
            </a>
          </div>
        </div>
      </div>
    </nav>
    <script>
      const u = JSON.parse(localStorage.getItem("ulsaham_user") || "null");
      const el = document.getElementById("hero-auth");
      const mobileLink = document.getElementById("mobile-account-link");
      const mobileLabel = document.getElementById("mobile-account-label");
      if (el && u) { el.href = "/account"; el.setAttribute("aria-label", "My Account"); el.innerHTML = `<span class="topbar-avatar__letter">${(u.name||"?")[0].toUpperCase()}</span>`; }
      if (mobileLink && u) { mobileLink.href = "/account"; }
      if (mobileLabel && u) { mobileLabel.textContent = `Hi, ${(u.name||"?").split(" ")[0]}`; }
      const wrap = document.getElementById("profile-menu-wrap");
      const dropdown = document.getElementById("mobile-nav-dropdown");
      if (el && wrap && dropdown) {
        el.addEventListener("click", function(e) {
          if (window.innerWidth <= 640) { e.preventDefault(); const open = dropdown.classList.toggle("is-open"); el.setAttribute("aria-expanded", open ? "true" : "false"); }
        });
        dropdown.querySelectorAll(".mobile-nav-dropdown__link").forEach(function(link) {
          link.addEventListener("click", function() { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); });
        });
        document.addEventListener("click", function(e) {
          if (!wrap.contains(e.target)) { dropdown.classList.remove("is-open"); el.setAttribute("aria-expanded", "false"); }
        });
      }
    </script>

    <div class="mx-auto max-w-3xl px-4 sm:px-6 pt-16 sm:pt-24 pb-16 md:pb-24">
      <h1 class="section-title text-3xl mb-2">Terms &amp; Conditions</h1>
      <p class="section-subtitle mb-12">Last updated: June 2025</p>

      <div class="space-y-10 text-light/80 leading-relaxed">

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">1. Acceptance of Terms</h2>
          <p>By accessing or using the Ulsaham Entertainments platform — including registering for events, purchasing tickets, or creating an account — you agree to be bound by these Terms &amp; Conditions. If you do not agree, please do not use our services.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">2. Event Tickets</h2>
          <p>All ticket purchases are final. Tickets are non-transferable and non-refundable unless an event is cancelled or rescheduled by Ulsaham Entertainments. Each ticket is valid for one-time entry only and must be presented at the venue.</p>
          <p>Ulsaham Entertainments reserves the right to deny entry to anyone who presents a duplicate, altered, or invalid ticket.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">3. Event Cancellation &amp; Refunds</h2>
          <p>In the event of a cancellation or significant rescheduling by Ulsaham Entertainments, registered attendees will be notified via email. Refunds, where applicable, will be processed within 7–14 business days to the original payment method.</p>
          <p>Ulsaham Entertainments is not liable for any indirect costs (travel, accommodation, etc.) incurred by attendees in connection with a cancelled event.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">4. User Accounts</h2>
          <p>You are responsible for maintaining the confidentiality of your account credentials. You agree to notify us immediately of any unauthorized use of your account. Ulsaham Entertainments is not liable for any loss arising from unauthorized account access due to your failure to secure your credentials.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">5. Conduct at Events</h2>
          <p>Attendees are expected to behave respectfully at all Ulsaham Entertainments events. We reserve the right to refuse entry or remove any individual who engages in disruptive, dangerous, or unlawful behaviour without refund.</p>
          <p>Photography and video recording may be permitted at certain events. Attendees consent to being photographed or recorded for promotional purposes unless they opt out at the venue.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">6. Intellectual Property</h2>
          <p>All content on this platform — including logos, graphics, event descriptions, and media — is the property of Ulsaham Entertainments. Reproduction or redistribution without written permission is prohibited.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">7. Limitation of Liability</h2>
          <p>Ulsaham Entertainments is not liable for any loss, injury, or damage arising from attendance at our events beyond what is required by applicable law. We do not guarantee uninterrupted access to our platform and are not responsible for technical failures beyond our control.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">8. Governing Law</h2>
          <p>These terms are governed by the laws of India. Any disputes arising shall be subject to the exclusive jurisdiction of the courts of Thrissur, Kerala.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">9. Changes to Terms</h2>
          <p>We reserve the right to modify these terms at any time. Updated terms will be posted on this page. Continued use of our platform after changes constitutes acceptance.</p>
        </section>

        <section class="space-y-4">
          <h2 class="text-lg font-semibold uppercase tracking-[0.2em] text-accent">10. Contact</h2>
          <p>For questions regarding these terms, contact us at:</p>
          <p><a href="mailto:ulsaham1@gmail.com" class="text-accent hover:underline">ulsaham1@gmail.com</a></p>
        </section>

      </div>
    </div>

    <footer class="bg-primary py-8 border-t border-light/10 text-center text-sm text-light/50">
      <a href="/about" class="hover:text-accent transition">About Us</a>
      <span class="mx-4">·</span>
      <a href="/terms" class="hover:text-accent transition">Terms &amp; Conditions</a>
      <span class="mx-4">·</span>
      <a href="/privacy" class="hover:text-accent transition">Privacy Policy</a>
      <span class="mx-4">·</span>
      <a href="https://www.instagram.com/ulsaham_?igsh=MTFsdzF4d2J5YXdzdQ==" target="_blank" rel="noreferrer" class="hover:text-accent transition">Instagram</a>
      <span class="mx-4">·</span>
      <a href="mailto:ulsaham1@gmail.com" class="hover:text-accent transition">Email</a>
      <span class="mx-4">·</span>
      <a href="https://wa.me/9446266011" target="_blank" rel="noreferrer" class="hover:text-accent transition">WhatsApp</a>
    </footer>

  </div>
</BaseLayout>
