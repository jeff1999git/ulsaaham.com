---
// The top bar of every page except /login, which keeps a simpler one.
//
// links: the section links, shown inline on wider screens and in the avatar's
// drop-down menu at 640 px and below. Most pages use the default.
// avatarHref: where the avatar leads before the script below knows whether
// someone is signed in (/account on the account page itself).
// The default slot sits beside the logo (the home page's sound button).
import navLogo from "../assets/brand_logo_128.avif?url";

const {
  links = [
    { href: "/events", label: "Events" },
    { href: "/#connect", label: "Connect" },
  ],
  avatarHref = "/login",
} = Astro.props;
const avatarLabel = avatarHref === "/account" ? "My Account" : "Login";
---

<nav class="hero-video__menu">
  <div style="display:flex;align-items:center;gap:0.75rem;">
    <a href="/" class="hero-logo-link" aria-label="Ulsaham Home">
      <img src={navLogo} alt="Ulsaham" class="topbar-logo" width="38" height="38" />
      <div class="hero-logo-link__brand">
        <span class="hero-logo-link__name">ULSAHAM</span>
        <span class="hero-logo-link__sub">Entertainments</span>
      </div>
    </a>
    <slot />
  </div>
  <div class="hero-video__menu-links">
    {links.map(({ href, label }) => <a class="hero-video__menu-link" href={href}>{label}</a>)}
    <div class="profile-menu-wrap" id="profile-menu-wrap">
      <a id="hero-auth" class="topbar-avatar" href={avatarHref} aria-label={avatarLabel} aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></a>
      <div class="mobile-nav-dropdown" id="mobile-nav-dropdown" role="menu">
        {links.map(({ href, label }) => <a href={href} class="mobile-nav-dropdown__link" role="menuitem">{label}</a>)}
        <div class="mobile-nav-dropdown__divider"></div>
        <a id="mobile-account-link" href={avatarHref} class="mobile-nav-dropdown__link mobile-nav-dropdown__link--account" role="menuitem">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          <span id="mobile-account-label">Account</span>
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // One copy for every page. getUser() never throws, even with storage
  // blocked or a damaged entry, so the menu below is always wired up.
  import { getUser } from "../lib/auth.js";

  const user = getUser();
  const avatar = document.getElementById("hero-auth");
  const accountLink = document.getElementById("mobile-account-link");
  const accountLabel = document.getElementById("mobile-account-label");

  // Signed in: the avatar shows the name's first letter and leads to the account page.
  if (user) {
    const name = String(user.name || "?");
    if (avatar) {
      avatar.href = "/account";
      avatar.setAttribute("aria-label", "My Account");
      const letter = document.createElement("span");
      letter.className = "topbar-avatar__letter";
      letter.textContent = name[0].toUpperCase();
      avatar.textContent = "";
      avatar.appendChild(letter);
    }
    if (accountLink) accountLink.href = "/account";
    if (accountLabel) accountLabel.textContent = `Hi, ${name.split(" ")[0]}`;
  }

  const wrap = document.getElementById("profile-menu-wrap");
  const dropdown = document.getElementById("mobile-nav-dropdown");
  if (avatar && wrap && dropdown) {
    // On narrow screens the avatar opens the menu, which holds the section links.
    avatar.addEventListener("click", function (e) {
      if (window.innerWidth <= 640) {
        e.preventDefault();
        const open = dropdown.classList.toggle("is-open");
        avatar.setAttribute("aria-expanded", open ? "true" : "false");
      }
    });
    dropdown.querySelectorAll(".mobile-nav-dropdown__link").forEach(function (link) {
      link.addEventListener("click", function () {
        dropdown.classList.remove("is-open");
        avatar.setAttribute("aria-expanded", "false");
      });
    });
    document.addEventListener("click", function (e) {
      if (!wrap.contains(e.target)) {
        dropdown.classList.remove("is-open");
        avatar.setAttribute("aria-expanded", "false");
      }
    });
  }
</script>
