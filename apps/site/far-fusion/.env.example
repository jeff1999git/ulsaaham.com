# ── OTP signing secret (generate with: openssl rand -hex 32) ──────────────────
# Required in production: sign-in is refused rather than run on a known value.
# Rotate it if the value has ever been pasted into a chat, ticket or screenshot.
# Rotating only breaks sign-in codes that are already in flight; nobody is
# signed out.
OTP_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Public site origin, used for links inside emails ──────────────────────────
SITE_URL=https://www.ulsaaham.com

# ── Brevo SMTP relay (Brevo > Settings > SMTP & API > SMTP) ───────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# The SMTP *login* Brevo shows you. It is a credential, not a sender address,
# and must never appear in a From header.
SMTP_USER=your-login@smtp-brevo.com
# The SMTP *key*: not the API key, not the account password. Brevo shows it once
# when you create it. A leading or trailing space makes Brevo answer 535.
SMTP_PASS=
# One verified sender per kind of mail: OTP_EMAIL_FROM signs people in,
# TICKET_EMAIL_FROM sends tickets. Both must be verified senders in Brevo, or on
# a domain authenticated there. Wrapping quotes are optional here and in the
# Vercel dashboard; the mailer strips one pair.
OTP_EMAIL_FROM="Ulsaham Entertainments <noreply@ulsaaham.com>"
TICKET_EMAIL_FROM="Tickets Ulsaham <tickets@ulsaaham.com>"

# ── Admin panel API ───────────────────────────────────────────────────────────
# Where the /api/public proxy and the ticket mailer reach the backend. A bare
# origin is enough; /api/public is appended when the path is missing. Left
# unset, a production build uses the live admin panel and anything else uses
# http://localhost:3000. A value present at build time is baked into that
# build, so on Vercel a change needs a redeploy.
# Under `astro dev` the browser's /api/public calls skip this and go through the
# read-only Vite proxy in astro.config.mjs (GET/HEAD to production only).
BACKEND_URL=http://localhost:3000

# ── Google OAuth (create at console.cloud.google.com) ─────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must match PROXY_SHARED_SECRET on the admin panel; lets the backend rate-limit
# per visitor, lets the ticket mailer look a booking up before sending it, and
# verifies the admin panel's signed requests to /api/internal/ticket-mail (the
# ticket email for bookings the Razorpay webhook completes). Without it that
# route answers 503, and production logs one warning per instance.
PROXY_SHARED_SECRET=
