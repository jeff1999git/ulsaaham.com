# ── OTP signing secret (generate with: openssl rand -hex 32) ──────────────────
OTP_SECRET=change-me-generate-with-openssl-rand-hex-32

# ── Nodemailer SMTP (fill in your email provider details) ─────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Ulsaaham Entertainments <noreply@yourdomain.com>"
